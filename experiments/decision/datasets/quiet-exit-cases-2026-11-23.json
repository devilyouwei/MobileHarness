    {"id": "discuss-en-02", "language": "en", "group": "exit_discuss", "sentence": "What do you think about that?", "expected": "exit"},
    {"id": "discuss-en-03", "language": "en", "group": "exit_discuss", "sentence": "Now, can you check tomorrow's weather for me?", "expected": "exit"},
    {"id": "discuss-en-04", "language": "en", "group": "exit_discuss", "sentence": "Let's discuss it.", "expected": "exit"},

    {"id": "continue-zh-01", "language": "zh-Hans", "group": "stay_continue", "sentence": "然后我昨天去了超市，发现价格涨了不少。", "expected": "stay"},
    {"id": "continue-zh-02", "language": "zh-Hans", "group": "stay_continue", "sentence": "第二点是预算要控制在十万以内。", "expected": "stay"},
    {"id": "continue-zh-03", "language": "zh-Hans", "group": "stay_continue", "sentence": "总之他当时就是这么跟我说的。", "expected": "stay"},
    {"id": "continue-zh-04", "language": "zh-Hans", "group": "stay_continue", "sentence": "接下来我要讲的是上个月的销售情况。", "expected": "stay"},
