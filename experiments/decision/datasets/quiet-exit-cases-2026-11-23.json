    {"id": "call-en-02", "language": "en", "group": "exit_call", "sentence": "Hello? Can you hear me?", "expected": "exit"},
    {"id": "call-en-03", "language": "en", "group": "exit_call", "sentence": "Hey Buddy, wake up.", "expected": "exit"},
    {"id": "call-en-04", "language": "en", "group": "exit_call", "sentence": "Computer, I need you.", "expected": "exit"},
    {"id": "call-en-05", "language": "en", "group": "exit_call", "sentence": "Okay Max, come back.", "expected": "exit"},
