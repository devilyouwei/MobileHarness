    {"id": "other-en-03", "language": "en", "group": "stay_other_person", "sentence": "Mom, I won't be home for dinner tonight.", "expected": "stay"},
    {"id": "other-en-04", "language": "en", "group": "stay_other_person", "sentence": "Sarah, did the meeting room get booked?", "expected": "stay"},
    {"id": "other-en-05", "language": "en", "group": "stay_other_person", "sentence": "Everyone, please take a seat, we're starting.", "expected": "stay"},
