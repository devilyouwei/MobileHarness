    {"id": "hold-zh-03", "language": "zh-Hans", "group": "stay_hold", "sentence": "等一下再回答我，我先把话说完。", "expected": "stay"},
    {"id": "hold-zh-04", "language": "zh-Hans", "group": "stay_hold", "sentence": "还不可以说话，再等等。", "expected": "stay"},
    {"id": "hold-zh-05", "language": "zh-Hans", "group": "stay_hold", "sentence": "你先听着，别回答。", "expected": "stay"},
