{
  "version": 1,
  "description": "Hand-written latest-sentence cases for ending the Assistant's quiet (wake) listening mode. Labels: exit = the user invites the assistant to talk again; stay = keep listening silently. Authored for this experiment; not drawn from device recordings or the App.",
  "groups": {
    "exit_invite": "Explicitly allows the assistant to speak",
    "exit_call": "Calls the assistant, by any name or greeting",
    "exit_discuss": "Wants to discuss with, or asks something of, the assistant",
    "stay_continue": "Continues the user's own account or thought",
    "stay_other_person": "Addressed to another person",
    "stay_selftalk": "Thinking aloud or fillers",
    "stay_hold": "Tells the assistant to keep quiet or defers the invitation",
    "stay_mention": "Mentions or quotes the assistant or an invitation without addressing it",
    "ambiguous": "Borderline; reported but not scored"
  },
  "cases": [
    {"id": "invite-zh-01", "language": "zh-Hans", "group": "exit_invite", "sentence": "好了，你可以说话了。", "expected": "exit"},
    {"id": "invite-zh-02", "language": "zh-Hans", "group": "exit_invite", "sentence": "我说完了，现在轮到你了。", "expected": "exit"},
    {"id": "invite-zh-03", "language": "zh-Hans", "group": "exit_invite", "sentence": "你现在可以跟我交流了。", "expected": "exit"},
    {"id": "invite-zh-04", "language": "zh-Hans", "group": "exit_invite", "sentence": "不用再安静了，可以回答我了。", "expected": "exit"},
    {"id": "invite-zh-05", "language": "zh-Hans", "group": "exit_invite", "sentence": "好，说完了，你说吧。", "expected": "exit"},
    {"id": "invite-zh-06", "language": "zh-Hans", "group": "exit_invite", "sentence": "可以了，你开口吧。", "expected": "exit"},
    {"id": "invite-zh-07", "language": "zh-Hans", "group": "exit_invite", "sentence": "行了，谢谢你刚才没打断我，现在你可以讲话了。", "expected": "exit"},
    {"id": "invite-zh-08", "language": "zh-Hans", "group": "exit_invite", "sentence": "安静模式结束，恢复对话。", "expected": "exit"},
    {"id": "invite-en-01", "language": "en", "group": "exit_invite", "sentence": "Okay, you can talk now.", "expected": "exit"},
    {"id": "invite-en-02", "language": "en", "group": "exit_invite", "sentence": "I'm done, it's your turn.", "expected": "exit"},
    {"id": "invite-en-03", "language": "en", "group": "exit_invite", "sentence": "You can speak again, thanks for waiting.", "expected": "exit"},
    {"id": "invite-en-04", "language": "en", "group": "exit_invite", "sentence": "All right, that's everything. Go ahead and answer me.", "expected": "exit"},
    {"id": "invite-en-05", "language": "en", "group": "exit_invite", "sentence": "You don't have to stay quiet anymore.", "expected": "exit"},
    {"id": "invite-en-06", "language": "en", "group": "exit_invite", "sentence": "Okay, quiet mode off, talk to me.", "expected": "exit"},
    {"id": "invite-en-07", "language": "en", "group": "exit_invite", "sentence": "Thanks for listening. You can respond now.", "expected": "exit"},
    {"id": "invite-en-08", "language": "en", "group": "exit_invite", "sentence": "Right, I've finished. Please say something.", "expected": "exit"},

    {"id": "call-zh-01", "language": "zh-Hans", "group": "exit_call", "sentence": "小助手，在吗？", "expected": "exit"},
