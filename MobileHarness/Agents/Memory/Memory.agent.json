{
  "version": 6,
  "id": "memory",
  "actions": {
    "Speech": [],
    "Display": []
  },
  "tools": [
    {
      "path": {
        "domain": "History",
        "module": "Conversation",
        "function": "list"
      },
      "definition": {
        "type": "function",
        "function": {
          "name": "History.list",
          "description": "List current and archived conversations, current first then newest archives. Returns paged JSON metadata with IDs and explicitly truncated title/input previews. Start at offset 0; use nextOffset for more.",
          "parameters": {
            "type": "object",
            "properties": {
              "offset": {
                "type": "string",
                "description": "Decimal integer from 0 through 64, encoded as a string."
              },
              "limit": {
                "type": "string",
                "description": "Decimal integer from 1 through 5, encoded as a string."
              }
            },
            "required": [
              "offset",
              "limit"
            ],
            "additionalProperties": false
          },
          "strict": true
        }
      }
    },
    {
      "path": {
        "domain": "History",
        "module": "Conversation",
        "function": "read"
      },
      "definition": {
        "type": "function",
        "function": {
          "name": "History.read",
          "description": "Read a conversation by an ID returned by History.list. Turns are oldest first. Returns paged JSON with bounded user/response previews and truncation flags, not complete text; never replays behavior. Start at offset 0.",
          "parameters": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Conversation UUID from History.list"
              },
              "offset": {
                "type": "string",
                "description": "Decimal integer from 0 through 256, encoded as a string."
              },
              "limit": {
                "type": "string",
                "description": "Decimal integer from 1 through 2, encoded as a string."
              }
            },
            "required": [
              "id",
              "offset",
              "limit"
            ],
            "additionalProperties": false
          },
          "strict": true
        }
      }
    }
  ],
  "communication": {
    "inputs": [
      {
        "contract": "history.intent",
        "version": 1,
        "kind": "observation"
      },
      {
        "contract": "tool.result",
        "version": 1,
        "kind": "toolResult"
      },
      {
        "contract": "task.request",
        "version": 1,
        "kind": "observation"
      },
      {
        "contract": "task.input",
        "version": 1,
        "kind": "observation"
      },
      {
        "contract": "task.progress",
        "version": 1,
        "kind": "observation"
      },
      {
        "contract": "task.result",
        "version": 1,
        "kind": "observation"
      },
      {
        "contract": "task.cancel",
        "version": 1,
        "kind": "observation"
      },
      {
        "contract": "action.result",
        "version": 1,
        "kind": "actionResult"
      },
      {
        "contract": "generation.round.result",
        "version": 1,
        "kind": "roundResult"
      },
      {
        "contract": "communication.receipt",
        "version": 1,
        "kind": "communicationReceipt"
      },
      {
        "contract": "user.text",
        "version": 1,
        "kind": "text"
      }
    ],
    "subscriptions": [
      {
        "contract": "history.intent",
        "source": "runtime",
        "topic": "history.intent"
      },
      {
        "contract": "history.intent",
        "source": "user",
        "topic": "history.intent"
      }
    ],
    "publications": [
      "interaction.replyActivity"
    ],
    "sends": [
      {
        "contract": "task.progress",
        "target": "assistant"
      },
      {
        "contract": "task.result",
        "target": "assistant"
      },
      {
        "contract": "speech.synthesize",
        "target": "speechSynthesis"
      },
      {
        "contract": "speech.cancel",
        "target": "speechSynthesis"
      }
    ]
  }
}
