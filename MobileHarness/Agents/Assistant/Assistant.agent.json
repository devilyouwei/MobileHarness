{
  "schemaVersion": 4,
  "agentID": "assistant",
  "channels": [
    "main"
  ],
  "textActions": [
    "say",
    "print"
  ],
  "actions": [
    {
      "alias": "say",
      "path": {
        "module": "Speech",
        "function": "speak"
      },
      "defaultChannel": "Speech",
      "parameters": [
        {
          "name": "text",
          "valueType": "string",
          "required": true,
          "description": "Text to speak.",
          "constraints": "Nonblank; at most 2000 UTF-8 bytes. Original formatting is preserved."
        }
      ],
      "examples": [
        "Hello."
      ],
      "doc": "Speak text aloud using the configured speech capability. Playback can be partially audible before an error. No silent fallback.",
      "hidden": true
    },
    {
      "alias": "print",
      "path": {
        "module": "UI",
        "function": "print"
      },
      "defaultChannel": "Display",
      "parameters": [
        {
          "name": "text",
          "valueType": "string",
          "required": true,
          "description": "Text to display.",
          "constraints": "Nonblank; at most 2000 UTF-8 bytes. Original formatting is preserved."
        }
      ],
      "examples": [
        "Hello."
      ],
      "doc": "Append text to the conversation caption. Preserves accepted text, including surrounding whitespace.",
      "hidden": true
    },
    {
      "alias": "express",
      "path": {
        "module": "UI",
        "function": "express"
      },
      "defaultChannel": "Display",
      "parameters": [
        {
          "name": "emotion",
          "valueType": "string",
          "required": true,
          "description": "The facial expression to display in the voice circle.",
          "constraints": "Exactly one of: clear, smile, happy, laugh, thinking, surprised, sad, love. clear removes the expression."
        }
      ],
      "examples": [
        "<express emotion=\"smile\"/> Hello.",
        "<express emotion=\"happy\"/> That is wonderful!",
        "<express emotion=\"thinking\"/> Let me think."
      ],
      "doc": "Show or clear the facial expression. clear removes it. Does not modify captions or speech. The Assistant clears its previous expression on new user speech.",
      "hidden": false
    },
    {
      "alias": "beginReplyTurn",
      "path": {
        "module": "UI",
        "function": "beginReplyTurn"
      },
      "defaultChannel": "Display",
      "parameters": [],
      "examples": [
        "<beginReplyTurn/>"
      ],
      "doc": "Begin the current conversation turn once: atomically clear the previous reply and expression. Preserve recognition text.",
      "hidden": true
    }
  ],
  "tools": [
    {
      "alias": "runtimeInfo",
      "path": "System.runtimeInfo",
      "parameters": [],
      "examples": [
        "{\"name\":\"runtimeInfo\",\"arguments\":{}}"
      ],
      "doc": "Read the fixed local runtime configuration description. This is not a live health or model-readiness probe.",
      "hidden": false
    }
  ],
  "communication": {
    "inputs": [
      {
        "contract": "user.text",
        "version": 1,
        "kind": "text"
      },
      {
        "contract": "runtime.event",
        "version": 1,
        "kind": "event"
      },
      {
        "contract": "tool.result",
        "version": 1,
        "kind": "toolResult"
      },
      {
        "contract": "speech.final",
        "version": 1,
        "kind": "observation"
      },
      {
        "contract": "speech.phase",
        "version": 1,
        "kind": "observation"
      }
    ],
    "subscriptions": [
      {
        "contract": "speech.final",
        "source": "speechPerception",
        "topic": "speech.final"
      },
      {
        "contract": "user.text",
        "source": "user",
        "topic": "user.text"
      },
      {
        "contract": "speech.phase",
        "source": "speechPerception",
        "topic": "speech.phase"
      }
    ],
    "publications": [],
    "sends": []
  }
}
