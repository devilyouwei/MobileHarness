{
  "version": 5,
  "id": "assistant",
  "actions": {
    "Display": [
      {
        "alias": "express",
        "path": {
          "module": "UI",
          "function": "express"
        },
        "parameters": [
          {
            "name": "emotion",
            "valueType": "string",
            "required": true,
            "description": "The emotion expressed by the two animated blue eyes; no emoji or text glyphs.",
            "constraints": "Exactly one of: clear, smile, happy, laugh, thinking, surprised, sad, love, angry, scared, playful. clear smoothly returns the eyes to neutral."
          }
        ],
        "examples": [
          "<express emotion=\"smile\"/> Hello.",
          "<express emotion=\"happy\"/> That is wonderful!",
          "<express emotion=\"thinking\"/> Let me think."
        ],
        "doc": "Smoothly change the procedural eye expression. clear returns to neutral. Never render an emoji as the expression. Does not modify captions or speech. The Assistant clears its previous expression on new user speech."
      }
    ],
    "Speech": []
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "runtimeInfo",
        "description": "Read the fixed local runtime configuration description. This is not a live health or model-readiness probe.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "strict": true
      }
    }
  ],
  "communication": {
    "inputs": [
      {
        "contract": "user.text",
        "version": 1,
        "kind": "text"
      },
      {
        "contract": "runtime.event",
        "version": 1,
        "kind": "event"
      },
      {
        "contract": "tool.result",
        "version": 1,
        "kind": "toolResult"
      },
      {
        "contract": "speech.final",
        "version": 1,
        "kind": "observation"
      },
      {
        "contract": "speech.phase",
        "version": 1,
        "kind": "observation"
      },
      {
        "contract": "action.result",
        "version": 1,
        "kind": "actionResult"
      }
    ],
    "subscriptions": [
      {
        "contract": "speech.final",
        "source": "speechPerception",
        "topic": "speech.final"
      },
      {
        "contract": "user.text",
        "source": "user",
        "topic": "user.text"
      },
      {
        "contract": "speech.phase",
        "source": "speechPerception",
        "topic": "speech.phase"
      }
    ],
    "publications": [],
    "sends": [
      {
        "contract": "speech.synthesize",
        "target": "speechSynthesis"
      },
      {
        "contract": "speech.cancel",
        "target": "speechSynthesis"
      }
    ]
  }
}
