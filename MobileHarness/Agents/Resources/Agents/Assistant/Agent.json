{
  "version": 14,
  "category": "cognition",
  "id": "assistant",
  "skills": [
    "basic-interaction"
  ],
  "states": [
    {
      "name": "task",
      "kind": "semantic",
      "access": "readWrite",
      "type": "text",
      "meaning": "The goal you are carrying across turns, set only from an explicit multi-step user instruction and cleared with a summary when done. See The task goal in AGENT CONTROLS.",
      "trigger": "task"
    },
    {
      "name": "listening",
      "kind": "typed",
      "access": "readWrite",
      "type": "bool",
      "meaning": "Whether to take part in the conversation. true by default. Set false when the user asks you to listen quietly. While false, a Decision checks whether the user has met the optional wakeCondition or invited you to speak again.",
      "trigger": "listening"
    }
  ],
  "channels": {
    "agent.task.v1": {
      "type": "send",
      "name": "agent.request"
    },
    "agent.task.events.v1": {
      "type": "pubSub",
      "name": "agent.task",
      "publish": true,
      "sources": [
        "writer"
      ]
    },
    "user.input.speech.v1": {
      "type": "pubSub",
      "name": "user.input.speech",
      "sources": [
        "speechPerception"
      ],
      "events": [
        "final"
      ]
    },
    "perception.speech.activity.v1": {
      "type": "pubSub",
      "name": "perception.speech.activity",
      "sources": [
        "speechPerception"
      ]
    },
    "perception.speech.keyword.v1": {
      "type": "pubSub",
      "name": "perception.speech.keyword",
      "sources": [
        "speechPerception"
      ],
      "events": [
        "keywordMatched"
      ]
    },
    "agent.interruption.v1": {
      "type": "pubSub",
      "name": "agent.interruption",
      "sources": [
        "applicationControl"
      ]
    },
    "runtime.delivery.v1": {
      "type": "send",
      "name": "runtime.agent",
      "receive": true
    }
  },
  "feedback": [
    "action.execution.event.v1",
    "action.result.v1",
    "tool.result.v1",
    "action.control.result.v1"
  ]
}
