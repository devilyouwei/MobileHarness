{
  "version": 12,
  "category": "cognition",
  "id": "assistant",
  "description": "I handle user conversation, understand goals, coordinate available capabilities and report actual results clearly. I own my foreground goals and respect other Agents' private contexts.",
  "skills": [
    "basic-interaction"
  ],
  "states": [
    {
      "name": "task",
      "kind": "semantic",
      "access": "readWrite",
      "type": "text",
      "meaning": "The goal you are carrying across turns, set only from an explicit multi-step user instruction and cleared with a summary when done. See The task goal in AGENT CONTROLS.",
      "trigger": "task"
    },
    {
      "name": "listening",
      "kind": "typed",
      "access": "readWrite",
      "type": "bool",
      "meaning": "Whether to take part in the conversation. true by default. Set false when the user asks you to listen quietly. While false, a Decision checks whether the user has met the optional wakeCondition or invited you to speak again.",
      "trigger": "listening"
    }
  ],
  "signals": {
    "requests": [],
    "feedback": [
      "action.execution.event.v1",
      "action.result.v1",
      "tool.result.v1",
      "action.control.result.v1"
    ],
    "publications": [
      {
        "channel": "agent.task",
        "protocol": "agent.task.events.v1"
      }
    ],
    "subscriptions": [
      {
        "channel": "user.input.speech",
        "protocol": "user.input.speech.v1",
        "sources": [
          "speechPerception"
        ],
        "events": [
          "final"
        ]
      },
      {
        "channel": "perception.speech.activity",
        "protocol": "perception.speech.activity.v1",
        "sources": [
          "speechPerception"
        ]
      },
      {
        "channel": "perception.speech.keyword",
        "protocol": "perception.speech.keyword.v1",
        "sources": [
          "speechPerception"
        ],
        "events": [
          "keywordMatched"
        ]
      },
      {
        "channel": "agent.interruption",
        "protocol": "agent.interruption.v1",
        "sources": [
          "applicationControl"
        ]
      },
      {
        "channel": "agent.task",
        "protocol": "agent.task.events.v1",
        "sources": [
          "writer"
        ]
      }
    ]
  }
}
