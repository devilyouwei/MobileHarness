{
  "version": 4,
  "id": "basic-interaction",
  "revision": 3,
  "dependencies": [],
  "useActions": [
    {
      "path": "Scheduling.Wait.wait",
      "callType": "scheduling",
      "alias": "wait"
    },
    {
      "path": "UI.Expression.express",
      "callType": "action",
      "alias": "express",
      "channel": "Display"
    },
    {
      "path": "UI.Expression.setExpression",
      "callType": "action",
      "alias": "setExpression",
      "channel": "Display"
    },
    {
      "path": "Speech.Listening.startListening",
      "callType": "action",
      "alias": "startListening",
      "channel": "ListeningControl"
    },
    {
      "path": "Speech.Listening.stopListening",
      "callType": "action",
      "alias": "stopListening",
      "channel": "ListeningControl"
    }
  ],
  "useStates": [
    "agents.applicationcontrol",
    "ui.navigation",
    "ui.windows",
    "ui.home.expression",
    "platform.system.time",
    "platform.system.power",
    "platform.system.thermal",
    "platform.system.network",
    "platform.system.permissions",
    "platform.system.audio",
    "platform.system.locale",
    "platform.system.accessibility",
    "agents.writer"
  ],
  "useInstructions": [
    "Instructions.md"
  ]
}
