{
  "version": 3,
  "id": "writer-workspace",
  "revision": 5,
  "description": "Find saved works and select, show, create or delete a workspace.",
  "owner": "writer",
  "dependencies": [],
  "useActions": [
    {
      "path": "Artifacts.Workspace.searchWorkspaces",
      "callType": "tool",
      "alias": "searchWorkspaces"
    },
    {
      "path": "Artifacts.Workspace.open",
      "callType": "tool",
      "alias": "open"
    },
    {
      "path": "Artifacts.Workspace.delete",
      "callType": "tool",
      "alias": "delete"
    },
    {
      "path": "Agent.Writer.enter",
      "callType": "tool",
      "alias": "enter"
    },
    {
      "path": "Agent.Writer.create",
      "callType": "tool",
      "alias": "create"
    },
    {
      "path": "Agent.Writer.ask",
      "callType": "tool",
      "alias": "ask"
    },
    {
      "path": "Agent.Writer.finish",
      "callType": "tool",
      "alias": "finish"
    }
  ],
  "useStates": [],
  "useInstructions": [
    "Instructions.md"
  ]
}
