{
  "version": 3,
  "id": "basic-skill",
  "revision": 37,
  "description": "Task and Skill orchestration, current State summaries and a single continuing foreground goal.",
  "dependencies": [],
  "useActions": [
    {
      "path": "Agent.Task.loadSkills",
      "callType": "action",
      "alias": "loadSkills",
      "channel": "Control"
    },
    {
      "path": "Agent.Task.releaseSkills",
      "callType": "action",
      "alias": "releaseSkills",
      "channel": "Control"
    },
    {
      "path": "Agent.Task.startTask",
      "callType": "action",
      "alias": "startTask",
      "channel": "Control"
    },
    {
      "path": "Agent.Task.finishTask",
      "callType": "action",
      "alias": "finishTask",
      "channel": "Control"
    },
    {
      "path": "Agent.Task.cancelTask",
      "callType": "action",
      "alias": "cancelTask",
      "channel": "Control"
    },
    {
      "path": "Speech.Listening.startListening",
      "callType": "action",
      "alias": "startListening",
      "channel": "ListeningControl"
    },
    {
      "path": "Speech.Listening.stopListening",
      "callType": "action",
      "alias": "stopListening",
      "channel": "ListeningControl"
    }
  ],
  "useStates": [
    "agents.applicationcontrol",
    "ui.navigation",
    "platform.system.time",
    "platform.system.power",
    "platform.system.thermal",
    "platform.system.network",
    "platform.system.permissions",
    "platform.system.audio",
    "platform.system.locale",
    "platform.system.accessibility"
  ],
  "useInstructions": [
    "Instructions.md"
  ]
}
