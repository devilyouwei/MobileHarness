{
  "version": 3,
  "id": "basic-skill",
  "revision": 51,
  "description": "Discover and load capabilities, manage foreground goals and Skill lifecycles, coordinate delegated work, and control listening using current context and execution feedback.",
  "dependencies": [],
  "useActions": [
    {
      "path": "Agent.Task.loadSkills",
      "callType": "action",
      "alias": "loadSkills",
      "channel": "Control"
    },
    {
      "path": "Agent.Task.releaseSkills",
      "callType": "action",
      "alias": "releaseSkills",
      "channel": "Control"
    },
    {
      "path": "Agent.Task.startTask",
      "callType": "action",
      "alias": "task.start",
      "channel": "Control"
    },
    {
      "path": "Agent.Task.finishTask",
      "callType": "action",
      "alias": "task.end",
      "channel": "Control"
    },
    {
      "path": "Agent.Task.cancelTask",
      "callType": "action",
      "alias": "task.cancel",
      "channel": "Control"
    },
    {
      "path": "Speech.Listening.startListening",
      "callType": "action",
      "alias": "startListening",
      "channel": "ListeningControl"
    },
    {
      "path": "Speech.Listening.stopListening",
      "callType": "action",
      "alias": "stopListening",
      "channel": "ListeningControl"
    },
    {
      "path": "Agent.Task.sendMessage",
      "callType": "action",
      "alias": "task.send",
      "channel": "Control"
    },
    {
      "path": "Agent.Task.delegateTask",
      "callType": "action",
      "alias": "task.delegate",
      "channel": "Control"
    }
  ],
  "useStates": [
    "agents.applicationcontrol",
    "ui.navigation",
    "ui.windows",
    "platform.system.time",
    "platform.system.power",
    "platform.system.thermal",
    "platform.system.network",
    "platform.system.permissions",
    "platform.system.audio",
    "platform.system.locale",
    "platform.system.accessibility",
    "agents.writer"
  ],
  "useInstructions": [
    "Instructions.md"
  ]
}
