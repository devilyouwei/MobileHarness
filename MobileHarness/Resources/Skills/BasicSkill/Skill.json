{
  "version": 3,
  "id": "basic-skill",
  "revision": 30,
  "description": "Task and Skill orchestration, current State summaries and a single continuing foreground goal.",
  "dependencies": [],
  "useActions": [
    {
      "path": "Agent.Task.loadSkills",
      "callType": "action",
      "alias": "loadSkills",
      "channel": "Control"
    },
    {
      "path": "Agent.Task.releaseSkills",
      "callType": "action",
      "alias": "releaseSkills",
      "channel": "Control"
    },
    {
      "path": "Agent.Task.startTask",
      "callType": "action",
      "alias": "startTask",
      "channel": "Control"
    },
    {
      "path": "Agent.Task.finishTask",
      "callType": "action",
      "alias": "finishTask",
      "channel": "Control"
    },
    {
      "path": "Agent.Task.cancelTask",
      "callType": "action",
      "alias": "cancelTask",
      "channel": "Control"
    }
  ],
  "useStates": [
    "agents.application",
    "ui.navigation",
    "platform.time",
    "platform.power",
    "platform.thermal",
    "platform.network",
    "platform.permissions",
    "platform.audio",
    "platform.locale",
    "platform.accessibility"
  ],
  "useInstructions": [
    "Instructions.md"
  ]
}
