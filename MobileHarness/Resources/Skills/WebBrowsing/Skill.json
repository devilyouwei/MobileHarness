{
  "version": 3,
  "id": "web-browsing",
  "revision": 8,
  "description": "Open or browse websites requested by site name or HTTP/HTTPS URL; read page text, inspect screenshots, scroll and control web windows. Does not provide clicking, form entry, login, video playback control or local-work library operations.",
  "dependencies": [],
  "useActions": [
    {
      "path": "Web.Page.browse",
      "callType": "action",
      "alias": "Web.browse",
      "channel": "Display"
    },
    {
      "path": "Web.Page.snapshot",
      "callType": "action",
      "alias": "Web.snapshot",
      "channel": "Display"
    },
    {
      "path": "Web.Page.inspect",
      "callType": "action",
      "alias": "Web.inspect",
      "channel": "Display"
    },
    {
      "path": "Web.Page.navigate",
      "callType": "action",
      "alias": "Web.navigate",
      "channel": "Display"
    },
    {
      "path": "UI.Window.focus",
      "callType": "action",
      "alias": "Window.focus",
      "channel": "Display"
    },
    {
      "path": "UI.Window.minimize",
      "callType": "action",
      "alias": "Window.minimize",
      "channel": "Display"
    },
    {
      "path": "UI.Window.maximize",
      "callType": "action",
      "alias": "Window.maximize",
      "channel": "Display"
    },
    {
      "path": "UI.Window.restore",
      "callType": "action",
      "alias": "Window.restore",
      "channel": "Display"
    },
    {
      "path": "UI.Window.move",
      "callType": "action",
      "alias": "Window.move",
      "channel": "Display"
    },
    {
      "path": "UI.Window.close",
      "callType": "action",
      "alias": "Window.close",
      "channel": "Display"
    }
  ],
  "useStates": [
    "ui.web",
    "ui.windows"
  ],
  "useInstructions": [
    "Instructions.md"
  ]
}
