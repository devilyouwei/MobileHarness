{
  "version": 3,
  "id": "web-drawing",
  "revision": 2,
  "description": "用文字创建或继续修改流程图、交互图形和动画；管理可保存的本地网页作品。",
  "dependencies": [
    "web-browsing"
  ],
  "useActions": [
    {
      "path": "Web.Page.develop",
      "callType": "action",
      "alias": "Web.develop",
      "channel": "Display"
    },
    {
      "path": "Web.Page.open",
      "callType": "action",
      "alias": "Web.open",
      "channel": "Display"
    },
    {
      "path": "Web.Page.projects",
      "callType": "action",
      "alias": "Web.projects",
      "channel": "Display"
    },
    {
      "path": "Web.Page.delete",
      "callType": "action",
      "alias": "Web.delete",
      "channel": "Display"
    }
  ],
  "useStates": [
    "ui.web",
    "ui.windows"
  ],
  "useInstructions": [
    "Instructions.md"
  ]
}
