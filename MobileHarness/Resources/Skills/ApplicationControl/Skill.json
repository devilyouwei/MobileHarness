{
  "version": 3,
  "id": "application-control",
  "revision": 20,
  "description": "Manage all windows (including Writer), app pages/settings, Bluetooth and background vision.",
  "dependencies": [],
  "useActions": [
    {
      "path": "UI.Navigation.open",
      "callType": "action",
      "alias": "openPage",
      "channel": "Display"
    },
    {
      "path": "System.ModelResources.snapshotResources",
      "callType": "action",
      "alias": "ModelResources.snapshot",
      "channel": "Query"
    },
    {
      "path": "System.Provider.readSettings",
      "callType": "action",
      "alias": "Provider.readSettings",
      "channel": "Query"
    },
    {
      "path": "System.Device.readStatus",
      "callType": "action",
      "alias": "Bluetooth.readStatus",
      "channel": "Query"
    },
    {
      "path": "System.Device.control",
      "callType": "action",
      "alias": "Bluetooth.control",
      "channel": "System"
    },
    {
      "path": "System.ModelResources.download",
      "callType": "action",
      "alias": "ModelResources.download",
      "channel": "System"
    },
    {
      "path": "System.ModelResources.cancel",
      "callType": "action",
      "alias": "ModelResources.cancel",
      "channel": "System"
    },
    {
      "path": "UI.Window.focus",
      "callType": "action",
      "alias": "Window.focus",
      "channel": "Display"
    },
    {
      "path": "UI.Window.minimize",
      "callType": "action",
      "alias": "Window.minimize",
      "channel": "Display"
    },
    {
      "path": "UI.Window.maximize",
      "callType": "action",
      "alias": "Window.maximize",
      "channel": "Display"
    },
    {
      "path": "UI.Window.restore",
      "callType": "action",
      "alias": "Window.restore",
      "channel": "Display"
    },
    {
      "path": "UI.Window.move",
      "callType": "action",
      "alias": "Window.move",
      "channel": "Display"
    },
    {
      "path": "UI.Window.close",
      "callType": "action",
      "alias": "Window.close",
      "channel": "Display"
    },
    {
      "path": "Camera.Perception.openVision",
      "callType": "action",
      "alias": "Vision.open",
      "channel": "Camera"
    },
    {
      "path": "Camera.Perception.closeVision",
      "callType": "action",
      "alias": "Vision.close",
      "channel": "Camera"
    },
    {
      "path": "Camera.Perception.flipVision",
      "callType": "action",
      "alias": "Vision.flip",
      "channel": "Camera"
    },
    {
      "path": "Camera.Perception.retryVision",
      "callType": "action",
      "alias": "Vision.retry",
      "channel": "Camera"
    },
    {
      "path": "UI.Island.setPresentation",
      "callType": "action",
      "alias": "Island.setPresentation",
      "channel": "Display"
    }
  ],
  "useStates": [
    "ui.windows",
    "ui.camera",
    "platform.vision.camera",
    "ui.island"
  ],
  "useInstructions": [
    "Instructions.md"
  ]
}
