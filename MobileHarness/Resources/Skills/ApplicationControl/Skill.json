{
  "version": 3,
  "id": "application-control",
  "revision": 11,
  "description": "Conversational page navigation, resource/provider/Bluetooth status and explicit supported device/resource operations.",
  "dependencies": [],
  "useActions": [
    {
      "path": "UI.Navigation.open",
      "callType": "action",
      "alias": "openPage",
      "channel": "Display"
    },
    {
      "path": "System.ModelResources.snapshotResources",
      "callType": "action",
      "alias": "ModelResources.snapshot",
      "channel": "Query"
    },
    {
      "path": "System.Provider.readSettings",
      "callType": "action",
      "alias": "Provider.readSettings",
      "channel": "Query"
    },
    {
      "path": "System.Device.readStatus",
      "callType": "action",
      "alias": "Bluetooth.readStatus",
      "channel": "Query"
    },
    {
      "path": "System.Device.control",
      "callType": "action",
      "alias": "Bluetooth.control",
      "channel": "System"
    },
    {
      "path": "System.ModelResources.download",
      "callType": "action",
      "alias": "ModelResources.download",
      "channel": "System"
    },
    {
      "path": "System.ModelResources.cancel",
      "callType": "action",
      "alias": "ModelResources.cancel",
      "channel": "System"
    }
  ],
  "useStates": [],
  "useInstructions": [
    "Instructions.md"
  ]
}
