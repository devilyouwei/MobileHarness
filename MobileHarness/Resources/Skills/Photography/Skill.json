{
  "version": 3,
  "id": "photography",
  "revision": 30,
  "description": "拍照、拍摄照片: open the photo window and capture/save/ignore/reshoot. Background vision/tracking belongs to application-control. Use a local Task only for continuing photo decisions.",
  "dependencies": [],
  "useActions": [
    {
      "path": "Camera.Capture.flip",
      "callType": "action",
      "alias": "flipCamera",
      "channel": "Camera"
    },
    {
      "path": "Camera.Capture.close",
      "callType": "action",
      "alias": "closeCamera",
      "channel": "Camera"
    },
    {
      "path": "Camera.Capture.open",
      "callType": "action",
      "alias": "openCamera",
      "channel": "Camera"
    },
    {
      "path": "Camera.Capture.takePhoto",
      "callType": "action",
      "alias": "takePhoto",
      "channel": "Camera"
    },
    {
      "path": "Camera.Capture.savePhoto",
      "callType": "action",
      "alias": "savePhoto",
      "channel": "Camera"
    },
    {
      "path": "Camera.Capture.ignorePhoto",
      "callType": "action",
      "alias": "ignorePhoto",
      "channel": "Camera"
    },
    {
      "path": "Camera.Capture.retry",
      "callType": "action",
      "alias": "retryCamera",
      "channel": "Camera"
    },
    {
      "path": "UI.Window.focus",
      "callType": "action",
      "alias": "Window.focus",
      "channel": "Display"
    },
    {
      "path": "UI.Window.minimize",
      "callType": "action",
      "alias": "Window.minimize",
      "channel": "Display"
    },
    {
      "path": "UI.Window.maximize",
      "callType": "action",
      "alias": "Window.maximize",
      "channel": "Display"
    },
    {
      "path": "UI.Window.restore",
      "callType": "action",
      "alias": "Window.restore",
      "channel": "Display"
    },
    {
      "path": "UI.Window.move",
      "callType": "action",
      "alias": "Window.move",
      "channel": "Display"
    },
    {
      "path": "UI.Window.close",
      "callType": "action",
      "alias": "Window.close",
      "channel": "Display"
    }
  ],
  "useStates": [
    "actions.camera",
    "ui.camera",
    "ui.album",
    "ui.windows",
    "platform.vision.camera"
  ],
  "useInstructions": [
    "Instructions.md"
  ]
}
