{
  "version": 2,
  "id": "photography",
  "revision": 25,
  "description": "Control camera/lens and capture/save-to-App-album/ignore/reshoot in Assistant, including capture-only. Use a local Task for continuing photo decisions; never delegate.",
  "dependencies": [],
  "functions": [
    {
      "path": "Camera.Capture.flip",
      "callType": "action",
      "alias": "flipCamera",
      "channel": "Camera"
    },
    {
      "path": "Camera.Capture.close",
      "callType": "action",
      "alias": "closeCamera",
      "channel": "Camera"
    },
    {
      "path": "Camera.Capture.open",
      "callType": "action",
      "alias": "openCamera",
      "channel": "Camera"
    },
    {
      "path": "Camera.Capture.takePhoto",
      "callType": "action",
      "alias": "takePhoto",
      "channel": "Camera"
    },
    {
      "path": "Camera.Capture.savePhoto",
      "callType": "action",
      "alias": "savePhoto",
      "channel": "Camera"
    },
    {
      "path": "Camera.Capture.ignorePhoto",
      "callType": "action",
      "alias": "ignorePhoto",
      "channel": "Camera"
    },
    {
      "path": "Camera.Capture.retry",
      "callType": "action",
      "alias": "retryCamera",
      "channel": "Camera"
    }
  ],
  "useState": [
    "camera"
  ]
}
