{
  "version": 8,
  "id": "speechPerception",
  "description": "I own listening consent, microphone intake, voice detection, speech recognition and sound-source observations. I publish recognized speech and enforce listening/playback lifecycle policy.",
  "communication": {
    "inputs": [
      {
        "contract": "action.result",
        "version": 1,
        "kind": "actionResult"
      },
      {
        "contract": "interaction.replyActivity",
        "version": 1,
        "kind": "observation"
      }
    ],
    "subscriptions": [
      {
        "contract": "interaction.replyActivity",
        "source": "assistant",
        "topic": "interaction.replyActivity"
      }
    ],
    "publications": [
      "speech.partial",
      "speech.final",
      "speech.phase",
      "sound.source"
    ],
    "sends": []
  },
  "baseSkills": [],
  "backgroundTasks": []
}
