{
  "version": 1,
  "controls": [
    {
      "alias": "state.set",
      "operation": "state.set",
      "destination": "self",
      "declaration": {
        "path": { "domain": "Agent", "module": "State", "function": "set" },
        "doc": "设置你自己的一个变量。值连同写入时间出现在你的 AGENT STATE 中。可使用任何简短的小写名称，部分名称有已声明的含义。",
        "parameters": [
          {
            "name": "name", "valueType": "string", "required": true,
            "description": "变量名称", "constraints": "小写字母、数字和下划线；以字母开头；最多 32 字节",
            "values": []
          },
          {
            "name": "value", "valueType": "string", "required": true,
            "description": "自然语言的值，或变量声明的类型化取值", "constraints": "非空，最多 1 KiB",
            "values": []
          },
          {
            "name": "note", "valueType": "string", "required": false,
            "description": "被替换旧值的摘要；仅在该变量驱动某个过程（如 task）且已有值时需要",
            "constraints": "长度有限", "values": []
          }
        ]
      }
    },
    {
      "alias": "state.clear",
      "operation": "state.clear",
      "destination": "self",
      "declaration": {
        "path": { "domain": "Agent", "module": "State", "function": "clear" },
        "doc": "清除你自己的一个变量。清除未设置的变量不产生任何变化。",
        "parameters": [
          {
            "name": "name", "valueType": "string", "required": true,
            "description": "变量名称", "constraints": "", "values": []
          },
          {
            "name": "note", "valueType": "string", "required": false,
            "description": "对该值存在期间实际发生之事的真实摘要；清除 task 时必填",
            "constraints": "长度有限", "values": []
          }
        ]
      }
    },
    {
      "alias": "state.get",
      "operation": "state.get",
      "destination": "self",
      "declaration": {
        "path": { "domain": "Agent", "module": "State", "function": "get" },
        "doc": "立即读取一个状态值并据此继续。读取自己的变量用简短名称，读取其他来源（如 ui.windows、platform.system.audio）用完整路径。",
        "parameters": [
          {
            "name": "path", "valueType": "string", "required": true,
            "description": "自己的变量名，或带点号的状态路径", "constraints": "", "values": []
          }
        ]
      }
    },
    {
      "alias": "skill.load",
      "operation": "skill.load",
      "destination": "self",
      "declaration": {
        "path": { "domain": "Agent", "module": "Skill", "function": "load" },
        "doc": "加载真实 Skill ID 及其依赖供后续请求使用，失败保留当前状态。",
        "parameters": [
          {
            "name": "skills", "valueType": "string", "required": true,
            "description": "由实际 Skill ID 组成的 JSON 数组。", "constraints": "ID 唯一且非空，最多 16 个",
            "values": []
          }
        ]
      }
    },
    {
      "alias": "skill.unload",
      "operation": "skill.unload",
      "destination": "self",
      "declaration": {
        "path": { "domain": "Agent", "module": "Skill", "function": "unload" },
        "doc": "卸载确认不再需要的非基础根 Skill，保留共享依赖。",
        "parameters": [
          {
            "name": "skills", "valueType": "string", "required": true,
            "description": "由实际 Skill ID 组成的 JSON 数组。", "constraints": "ID 唯一且非空，最多 16 个",
            "values": []
          }
        ]
      }
    },
    {
      "alias": "send",
      "operation": "send",
      "destination": "peer",
      "declaration": {
        "path": { "domain": "Agent", "module": "Message", "function": "send" },
        "doc": "将完整目标、补充、回答或停止请求发送给实际可委托的同伴。送达仅代表接收。",
        "parameters": [
          {
            "name": "agent_id", "valueType": "string", "required": true,
            "description": "可委托目录中的实际 Agent ID。", "constraints": "", "values": []
          },
          {
            "name": "text", "valueType": "string", "required": true,
            "description": "用户目标、补充、回答或实际文本。", "constraints": "", "values": []
          }
        ]
      }
    }
  ]
}
