{
  "version": 1,
  "controls": [
    {
      "alias": "loadSkills",
      "operation": "loadSkills",
      "destination": "self",
      "declaration": {
        "path": { "domain": "Agent", "module": "Task", "function": "loadSkills" },
        "doc": "加载真实 Skill ID 及其依赖供后续请求使用，失败保留当前状态。",
        "parameters": [
          {
            "name": "skills", "valueType": "string", "required": true,
            "description": "由实际 Skill ID 组成的 JSON 数组。", "constraints": "ID 唯一且非空，最多 16 个",
            "values": []
          }
        ]
      }
    },
    {
      "alias": "releaseSkills",
      "operation": "releaseSkills",
      "destination": "self",
      "declaration": {
        "path": { "domain": "Agent", "module": "Task", "function": "releaseSkills" },
        "doc": "释放确认不再需要的非基础根 Skill，保留共享依赖和任务。",
        "parameters": [
          {
            "name": "skills", "valueType": "string", "required": true,
            "description": "由实际 Skill ID 组成的 JSON 数组。", "constraints": "ID 唯一且非空，最多 16 个",
            "values": []
          }
        ]
      }
    },
    {
      "alias": "task.start",
      "operation": "task.start",
      "destination": "self",
      "declaration": {
        "path": { "domain": "Agent", "module": "Task", "function": "startTask" },
        "doc": "建立可判定完成条件的前台目标，并持有必要的初始 Skill。",
        "parameters": [
          {
            "name": "description", "valueType": "string", "required": true,
            "description": "可判定完成条件的目标说明。", "constraints": "", "values": []
          },
          {
            "name": "skills", "valueType": "string", "required": false,
            "description": "由实际 Skill ID 组成的 JSON 数组。", "constraints": "", "values": []
          }
        ]
      }
    },
    {
      "alias": "task.end",
      "operation": "task.end",
      "destination": "self",
      "declaration": {
        "path": { "domain": "Agent", "module": "Task", "function": "finishTask" },
        "doc": "根据实际结果结束当前前台任务并记录摘要。",
        "parameters": [
          {
            "name": "summary", "valueType": "string", "required": true,
            "description": "简短且真实的结果摘要。", "constraints": "非空且长度有限", "values": []
          },
          {
            "name": "continueDecision", "valueType": "boolean", "required": false,
            "description": "任务结束后是否继续处理本次输入中的新目标。",
            "constraints": "true 或 false；默认 false", "values": ["true", "false"]
          }
        ]
      }
    },
    {
      "alias": "task.send",
      "operation": "task.send",
      "destination": "peer",
      "declaration": {
        "path": { "domain": "Agent", "module": "Task", "function": "sendMessage" },
        "doc": "将完整目标、补充、回答或停止请求发送给实际可委托的同伴。送达仅代表接收。",
        "parameters": [
          {
            "name": "agent_id", "valueType": "string", "required": true,
            "description": "可委托目录中的实际 Agent ID。", "constraints": "", "values": []
          },
          {
            "name": "text", "valueType": "string", "required": true,
            "description": "用户目标、补充、回答或实际文本。", "constraints": "", "values": []
          }
        ]
      }
    }
  ]
}
