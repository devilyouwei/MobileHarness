{
  "version": 10,
  "category": "cognition",
  "id": "assistant",
  "description": "I handle user conversation, understand goals, coordinate available capabilities and report actual results clearly. I own my foreground goals and respect other Agents' private contexts.",
  "communication": {
    "inputs": [
      {
        "contract": "tool.result",
        "version": 1,
        "kind": "toolResult"
      },
      {
        "contract": "action.result",
        "version": 1,
        "kind": "actionResult"
      },
      {
        "contract": "generation.round.result",
        "version": 1,
        "kind": "roundResult"
      },
      {
        "contract": "communication.receipt",
        "version": 1,
        "kind": "communicationReceipt"
      },
      {
        "contract": "task.progress",
        "version": 1,
        "kind": "observation"
      },
      {
        "contract": "task.result",
        "version": 1,
        "kind": "observation"
      },
      {
        "contract": "writer.completion",
        "version": 1,
        "kind": "observation"
      }
    ],
    "subscriptions": [
      {
        "contract": "user.input.asr.final",
        "source": "speechPerception",
        "topic": "user.input"
      }
    ],
    "publications": [],
    "sends": [
      {
        "contract": "task.request",
        "target": "writer"
      },
      {
        "contract": "task.input",
        "target": "writer"
      },
      {
        "contract": "task.cancel",
        "target": "writer"
      }
    ]
  },
  "baseSkills": [
    "basic-skill",
    "expression-interaction"
  ]
}
